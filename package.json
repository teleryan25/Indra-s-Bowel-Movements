{
  "name": "indras-bowel-operations-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Indra's Bowel Operations Center™ — mission-critical digestive infrastructure.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:insights": "vitest run src/insights/__tests__/validation.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "icons": "node scripts/generate-icons.mjs",
    "qa": "node scripts/mobile-qa.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
